# Copy to .env and fill in what you have. Everything is optional: without keys the agents run
# with deterministic rules (offline mode), tracing is off and the RAGAS LLM metrics are skipped.

# --- LLM for the agents (and, by default, the RAGAS judge) ---------------------------------
# mock | groq | openai | anthropic | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b          # Groq default
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: a different judge for RAGAS (defaults to the agents' provider/model)
# JUDGE_PROVIDER=groq
# JUDGE_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b   # used in turn (Groq default)

# --- Langfuse (https://cloud.langfuse.com or self-hosted) ----------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# --- Server ---------------------------------------------------------------------------------
# PUBLIC_BASE_URL=http://localhost:8000   # where the A2A agent cards say the agents live
# A2A_RISK_URL=http://localhost:8101/a2a/risk        # run the agents as separate services
# A2A_COMPLIANCE_URL=http://localhost:8102/a2a/compliance
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/quantfolio?sslmode=require   # Neon, as copied
#   (unset: SQLite files in data/; Postgres also holds checkpoints, the broker ledger and added clients)
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app      # Vercel preview deployments
# API_KEY=                                 # require X-API-Key on /api/v1

# --- Guardrails and security ------------------------------------------------------------------
# GUARDRAILS_ENABLED=true
# SEMANTIC_INJECTION_THRESHOLD=            # calibrated by scripts/eval_guardrails.py (see app/config.py)
# CITATION_SUPPORT_THRESHOLD=              # calibrated by scripts/calibrate_citations.py
# APPROVAL_SECRET=                         # signs approval tokens; default: random key in data/.approval_secret
# MAX_ORDER_FRACTION=0.35                  # no single order above this share of the account
# RATE_LIMIT_RUNS=12                       # new runs per address per RATE_LIMIT_WINDOW_SECONDS

# --- Memory -----------------------------------------------------------------------------------
# RESEARCH_CACHE_ENABLED=true
# MEMORY_EPISODES_RECALLED=3

# --- Data refresh (scripts/fetch_data.py) ---------------------------------------------------
# SEC_USER_AGENT="Your Name your.email@example.com"
