# Copy to .env and fill in what you have. Everything is optional: without keys the agents run
# with deterministic rules (offline mode), tracing is off and the RAGAS LLM metrics are skipped.

# --- LLM for the agents (and, by default, the RAGAS judge) ---------------------------------
# mock | groq | openai | anthropic | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: a different judge for RAGAS (defaults to the agents' provider/model)
# JUDGE_PROVIDER=groq
# JUDGE_MODEL=

# --- Langfuse (https://cloud.langfuse.com or self-hosted) ----------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# --- Server ---------------------------------------------------------------------------------
# PUBLIC_BASE_URL=http://localhost:8000   # where the A2A agent cards say the agents live
# A2A_RISK_URL=http://localhost:8101/a2a/risk        # run the agents as separate services
# A2A_COMPLIANCE_URL=http://localhost:8102/a2a/compliance
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/quantfolio
# API_KEY=                                 # require X-API-Key on /api/v1

# --- Quantum --------------------------------------------------------------------------------
# QAOA_REPS=2
# QAOA_MAXITER=60
# QAOA_MIXER=xy                            # xy (always valid) | x (standard)

# --- Data refresh (scripts/fetch_data.py) ---------------------------------------------------
# SEC_USER_AGENT="Your Name your.email@example.com"
